<div class="pill-lg {{#unless path}}roboto-upper empty{{/unless}}"
     {{~#if path}} data-uuid="{{ path.uuid }}"{{else}} data-action="browse"{{/if}}>
    {{#if path}}
    <img class="gold-icon" data-action="viewItem" src="{{ path.img }}" alt="{{ path.name }}">
    <div class="name-stacked">
        <div class="title">{{ path.name }}</div>
    </div>
    <button type="button" class="unbutton control-button item-control" data-action="deleteItem"
            data-tooltip aria-label="{{ localize 'DND5E.ItemDelete' }}">
        <i class="fas fa-trash" inert></i>
    </button>
    {{else}}
    {{ localize "ADVANCEMENT_CLASSES.Advancement.Path.Select" }}
    {{/if}}
</div>
