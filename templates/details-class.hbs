<fieldset>
    <legend>{{ localize "ADVANCEMENT_CLASSES.Details.ClassDetails" }}</legend>

    {{!-- Identifier --}}
    {{ formField fields.identifier value=source.identifier placeholder=item.identifier
                 localize=true rootId=partId }}

    {{!-- Journal Link --}}
    {{ formField fields.journal value=source.journal localize=true rootId=partId }}

    {{!-- Hit Die (used by Hit Points advancements) --}}
    <div class="form-group">
        <label>{{ localize "DND5E.HitDie" }}</label>
        <div class="form-fields">
            <select name="system.hd.denomination">
                {{ selectOptions hitDieOptions selected=source.hd.denomination }}
            </select>
        </div>
    </div>
</fieldset>

<fieldset>
    <legend>{{ localize "ADVANCEMENT_CLASSES.Class.StageNames" }}</legend>
    <p class="hint">{{ localize "ADVANCEMENT_CLASSES.Class.StageNamesHint" }}</p>
    {{#each stageNameRows}}
    <div class="form-group">
        <label>{{ localize "ADVANCEMENT_CLASSES.Stage" stage=stage }}</label>
        <div class="form-fields">
            <input type="text" name="system.stageNames.{{ stage }}" value="{{ name }}">
        </div>
    </div>
    {{/each}}
</fieldset>

<fieldset>
    <legend>{{ localize "ADVANCEMENT_CLASSES.Class.GiftTiers" }}</legend>
    <p class="hint">{{ localize "ADVANCEMENT_CLASSES.Class.GiftTiersHint" }}</p>
    {{#each giftTierRows}}
    <fieldset>
        <legend>
            {{ label }}
            {{#if ../canDeleteGiftTier}}
            <button type="button" class="unbutton" data-action="deleteGiftTier" data-tier-id="{{ id }}"
                    data-tooltip="{{ localize 'ADVANCEMENT_CLASSES.Class.GiftTierDelete' }}">
                <i class="fa-solid fa-trash" inert></i>
            </button>
            {{/if}}
        </legend>
        <div class="form-group">
            <label>{{ localize "ADVANCEMENT_CLASSES.Class.GiftTierLabel" }}</label>
            <div class="form-fields">
                <input type="text" name="system.gifts.tiers.{{ id }}.label" value="{{ label }}">
            </div>
        </div>
        <div class="form-group">
            <label>{{ localize "ADVANCEMENT_CLASSES.Class.GiftTierSort" }}</label>
            <div class="form-fields">
                <input type="number" name="system.gifts.tiers.{{ id }}.sort" value="{{ sort }}" step="1">
            </div>
        </div>
        {{#each requires}}
        <div class="form-group">
            <label>{{ localize "ADVANCEMENT_CLASSES.Class.GiftTierRequires" label=label }}</label>
            <div class="form-fields">
                <input type="number" name="system.gifts.tiers.{{ ../id }}.requires.{{ id }}" value="{{ value }}" min="0" step="1">
            </div>
        </div>
        {{/each}}
    </fieldset>
    {{/each}}
    <button type="button" data-action="addGiftTier">{{ localize "ADVANCEMENT_CLASSES.Class.GiftTierAdd" }}</button>
</fieldset>
