<fieldset>
    <legend>{{ localize "ADVANCEMENT_CLASSES.Details.MilestoneDetails" }}</legend>

    {{!-- Milestone Type --}}
    {{ formField fields.milestoneType value=source.milestoneType localize=true rootId=partId }}

    {{!-- Progress --}}
    <div class="form-group">
        <label>{{ localize "ADVANCEMENT_CLASSES.Milestone.Progress" }}</label>
        <div class="form-fields">
            {{ formInput fields.progress.fields.value value=source.progress.value rootId=partId }}
            <span class="sep">/</span>
            {{ formInput fields.progress.fields.max value=source.progress.max rootId=partId }}
        </div>
        <p class="hint">{{ localize "ADVANCEMENT_CLASSES.Milestone.CounterHint" }}</p>
    </div>
</fieldset>
