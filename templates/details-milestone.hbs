<fieldset>
    <legend>{{ localize "ADVANCEMENT_CLASSES.Details.MilestoneDetails" }}</legend>

    {{!-- Milestone Type --}}
    <div class="form-group">
        <label>{{ localize "ADVANCEMENT_CLASSES.Milestone.Type.Label" }}</label>
        <div class="form-fields">
            <select name="system.milestoneType">
                {{ selectOptions milestoneTypes selected=source.milestoneType }}
            </select>
        </div>
    </div>

    {{!-- Progress --}}
    <div class="form-group">
        <label>{{ localize "ADVANCEMENT_CLASSES.Milestone.Progress" }}</label>
        <div class="form-fields">
            {{ formInput fields.progress.fields.value value=source.progress.value rootId=partId }}
            <span class="sep">/</span>
            {{ formInput fields.progress.fields.max value=source.progress.max rootId=partId }}
        </div>
        <p class="hint">{{ localize "ADVANCEMENT_CLASSES.Milestone.Type.CounterHint" }}</p>
    </div>

    {{!-- Auto-Tracking --}}
    <div class="form-group">
        <label>{{ localize "ADVANCEMENT_CLASSES.Milestone.Tracking.Event" }}</label>
        <div class="form-fields">
            {{ formInput fields.tracking.fields.event value=source.tracking.event rootId=partId }}
        </div>
        <p class="hint">{{ localize "ADVANCEMENT_CLASSES.Milestone.Tracking.EventHint" }}</p>
    </div>
    <div class="form-group">
        <label>{{ localize "ADVANCEMENT_CLASSES.Milestone.Tracking.Unique" }}</label>
        <div class="form-fields">
            {{ formInput fields.tracking.fields.uniqueTargets value=source.tracking.uniqueTargets rootId=partId }}
        </div>
        <p class="hint">{{ localize "ADVANCEMENT_CLASSES.Milestone.Tracking.UniqueHint" }}</p>
    </div>

    {{!-- Calling configuration (milestoneType: calling) --}}
    <div class="form-group">
        <label>{{ localize "ADVANCEMENT_CLASSES.Milestone.Calling.ChoiceSet" }}</label>
        <div class="form-fields">
            {{ formInput fields.calling.fields.choiceSet value=source.calling.choiceSet rootId=partId }}
        </div>
        <p class="hint">{{ localize "ADVANCEMENT_CLASSES.Milestone.Calling.ChoiceSetHint" }}</p>
    </div>
    <div class="form-group">
        <label>{{ localize "ADVANCEMENT_CLASSES.Milestone.Calling.ChoiceKey" }}</label>
        <div class="form-fields">
            {{ formInput fields.calling.fields.choiceKey value=source.calling.choiceKey rootId=partId }}
        </div>
        <p class="hint">{{ localize "ADVANCEMENT_CLASSES.Milestone.Calling.ChoiceKeyHint" }}</p>
    </div>
    <div class="form-group">
        <label>{{ localize "ADVANCEMENT_CLASSES.Milestone.Calling.GiftSource" }}</label>
        <div class="form-fields">
            {{ formInput fields.calling.fields.giftSource value=source.calling.giftSource rootId=partId }}
        </div>
        <p class="hint">{{ localize "ADVANCEMENT_CLASSES.Milestone.Calling.GiftSourceHint" }}</p>
    </div>
    <div class="form-group">
        <label>{{ localize "ADVANCEMENT_CLASSES.Milestone.Calling.GiftTiers" }}</label>
        <div class="form-fields">
            {{#each giftTiers}}
            <label class="checkbox">
                <input type="checkbox" name="system.calling.giftTiers" value="{{ value }}" {{#if checked}}checked{{/if}}>
                {{ label }}
            </label>
            {{/each}}
        </div>
    </div>
</fieldset>
